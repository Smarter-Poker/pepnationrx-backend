# PepNationRX backend — environment variables
# Copy to .env and fill in real values during vendor onboarding.
# Every value below is a placeholder. Do NOT commit the real .env.

PORT=3000

# --- SteadyMD (clinical API) ---
# TODO(onboarding): reconcile with real SteadyMD API spec
STEADYMD_API_BASE_URL=https://REPLACE_AT_ONBOARDING.steadymd.example
STEADYMD_API_KEY=REPLACE_AT_ONBOARDING
STEADYMD_WEBHOOK_SECRET=REPLACE_AT_ONBOARDING

# --- Empower Pharmacy (compounding, REST/JSON) ---
# TODO(onboarding): reconcile with real Empower Pharmacy API spec
EMPOWER_API_BASE_URL=https://REPLACE_AT_ONBOARDING.empower.example
EMPOWER_API_KEY=REPLACE_AT_ONBOARDING
EMPOWER_WEBHOOK_SECRET=REPLACE_AT_ONBOARDING

# --- Hallandale Pharmacy (compounding, LifeFile-based) ---
# TODO(onboarding): reconcile with real Hallandale / LifeFile API spec
HALLANDALE_API_BASE_URL=https://REPLACE_AT_ONBOARDING.hallandale.example
HALLANDALE_API_KEY=REPLACE_AT_ONBOARDING
HALLANDALE_WEBHOOK_SECRET=REPLACE_AT_ONBOARDING

# --- Persistence ---
# TODO(onboarding): provision a HIPAA-eligible database before handling real PHI
DATABASE_URL=REPLACE_AT_ONBOARDING

# --- Payments ---
# TODO(onboarding): replace with real Stripe secret key
STRIPE_SECRET_KEY=REPLACE_AT_ONBOARDING

# --- Authentication ---
# TODO(prod): SESSION_COOKIE_SECRET signs the patient session cookie. It MUST
# be a long, random, secret value loaded from a secrets manager — never the
# placeholder below, never committed. Rotating it logs every patient out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_COOKIE_SECRET=REPLACE_AT_ONBOARDING
# Set NODE_ENV=production so the session cookie gets the Secure flag (HTTPS-only).
NODE_ENV=development
# Session timeouts (ms). HIPAA requires automatic logoff after inactivity.
SESSION_IDLE_TIMEOUT_MS=1800000          # 30 min sliding inactivity timeout
SESSION_ABSOLUTE_TIMEOUT_MS=43200000     # 12 h absolute session cap
# Brute-force protection.
AUTH_MAX_FAILED_LOGINS=5                 # lock the account after N failures
AUTH_LOCKOUT_MS=900000                   # 15 min lockout
# Single-use token lifetimes.
AUTH_RESET_TTL_MS=900000                 # password-reset link valid 15 min
AUTH_VERIFY_TTL_MS=86400000              # email-verification link valid 24 h
