{
  "name": "pepnationrx-backend",
  "version": "0.1.0",
  "description": "Scaffolded telehealth MSO backend for PepNationRX — integrates SteadyMD, Empower Pharmacy, and Hallandale Pharmacy with conditional pharmacy routing.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/test-intake.js && PNRX_NO_LISTEN=1 node scripts/test-auth.js",
    "test:intake": "node scripts/test-intake.js",
    "test:auth": "PNRX_NO_LISTEN=1 node scripts/test-auth.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  }
}
